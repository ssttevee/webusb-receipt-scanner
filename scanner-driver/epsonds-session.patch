diff --git a/backend/epsonds-cmd.c b/backend/epsonds-cmd.c
--- a/backend/epsonds-cmd.c
+++ b/backend/epsonds-cmd.c
@@ -780,6 +780,18 @@ SANE_Status esci2_capa(epsonds_scanner *s)
 
 /* STAT */
 
+/* Firmware may pad its four-byte status codes with one or two spaces. */
+static SANE_Bool stat_value_is(const char *value, int len, const char *expected)
+{
+	int size = strlen(expected);
+	if (len < size || memcmp(value, expected, size) != 0)
+		return SANE_FALSE;
+	for (int i = size; i < len; ++i)
+		if (value[i] != ' ' && value[i] != '\0')
+			return SANE_FALSE;
+	return SANE_TRUE;
+}
+
 static SANE_Status stat_cb(void *userdata, char *token, int len)
 {
 	char *value = token + 3;
@@ -791,15 +803,19 @@ static SANE_Status stat_cb(void *userdata, char *token, int len)
 	}
 
 	if (strncmp("ERR", token, 3) == 0) {
-		if (strncmp("ADF PE ", value, len) == 0) {
+		if (stat_value_is(value, len, "ADF PE")) {
 			DBG(1, "     PE : paper empty\n");
 			return SANE_STATUS_NO_DOCS;
 		}
 
-		if (strncmp("ADF OPN", value, len) == 0) {
+		if (stat_value_is(value, len, "ADF OPN")) {
 			DBG(1, "     conver open\n");
 			return SANE_STATUS_COVER_OPEN;
 		}
+		if (stat_value_is(value, len, "ADF PJ"))
+			return SANE_STATUS_JAMMED;
+		/* Unknown error tokens must not authorize a new image transfer. */
+		return SANE_STATUS_IO_ERROR;
 	}
 
 	return SANE_STATUS_GOOD;
